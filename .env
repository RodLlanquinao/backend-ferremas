# FERREMAS Backend - Variables de entorno para desarrollo local

# Configuración del servidor
PORT=8000
NODE_ENV=development

# Configuración de CORS - Permitir solo el frontend
CORS_ORIGIN=http://localhost:3001

# Configuración de la base de datos
DATABASE_URL=postgresql://postgres:uexpNYYvegSXHBMbAyxxjbzXoogbqvpL@centerbeam.proxy.rlwy.net:43365/railway?sslmode=disable

# Configuración SSL para base de datos
DB_SSL_ENABLED=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_CONNECTION_TIMEOUT=5000

# Nivel de logging
LOG_LEVEL=debug

# Configuración de seguridad
JWT_SECRET=ferremas_development_secret_key_change_in_production

# Tamaño máximo de peticiones
MAX_REQUEST_SIZE=10mb

# URL de la aplicación
RAILWAY_STATIC_URL=http://localhost:8000

# Firebase Configuration - Credenciales del Service Account
FIREBASE_PROJECT_ID=ferremas-fb253
